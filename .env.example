# Copy to .env (project root or backend/) — it is loaded automatically. Real environment variables win.

# --- Storage -----------------------------------------------------------------
# Default: SQLite at backend/infrasight.db (absolute, so scripts run from any folder share it).
# DATABASE_URL=sqlite:///C:/path/to/infrasight.db
# PostgreSQL alternative: postgresql+psycopg://infrasight:infrasight@localhost:5432/infrasight
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# UPLOAD_DIR=backend/uploads

# --- Local LLM (Ollama) -------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Instruct (non-thinking) models. The plain "qwen3-vl:8b" tag is a thinking model and returns empty JSON.
QWEN_MODEL=qwen3-vl:4b-instruct
TEXT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m
IMAGE_MAX_SIDE=1600

# --- OCR and matching ---------------------------------------------------------
OCR_ENABLED=true
# auto | sentence-transformers | ollama | lexical
MATCHER_BACKEND=auto
MATCHER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCH_HIGH_CONFIDENCE=0.80
MATCH_LOW_CONFIDENCE=0.40

# --- Auth -------------------------------------------------------------------------
AUTH_ENABLED=true
# Leave empty to auto-generate backend/.secret_key on first start.
JWT_SECRET=
TOKEN_HOURS=12
# Shows demo accounts on the login page. Set false for anything shared.
DEMO_MODE=true

# --- Project / ML ---------------------------------------------------------------
PROJECT_AS_OF=2026-10-01
# MODEL_DIR=ml/models
